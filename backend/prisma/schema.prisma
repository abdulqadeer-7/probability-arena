generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum Language {
  EN
  UR

  @@map("language")
}

enum Theme {
  LIGHT
  DARK

  @@map("theme")
}

enum TransactionType {
  CREDIT
  DEBIT

  @@map("transaction_type")
}

enum TransactionReason {
  SIGNUP_BONUS
  DAILY_BONUS
  GAME_WAGER
  GAME_WIN
  GAME_LOSS
  RESET
  ADMIN_ADJUSTMENT
  ACHIEVEMENT_REWARD
  CHALLENGE_REWARD

  @@map("transaction_reason")
}

enum GameStatus {
  PENDING
  COMPLETED
  CANCELLED

  @@map("game_status")
}

enum ChallengeType {
  DAILY
  WEEKLY

  @@map("challenge_type")
}

enum LeaderboardPeriod {
  ALL_TIME
  WEEKLY
  DAILY

  @@map("leaderboard_period")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("support_ticket_status")
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH

  @@map("support_ticket_priority")
}

enum RestrictionType {
  COOLDOWN
  SELF_LOCK
  SUSPENSION

  @@map("restriction_type")
}

enum AnnouncementType {
  INFO
  WARNING
  MAINTENANCE

  @@map("announcement_type")
}

model User {
  id              String    @id @default(uuid()) @map("id")
  email           String    @unique @map("email")
  passwordHash    String    @map("password_hash")
  displayName     String    @map("display_name")
  avatarUrl       String?   @map("avatar_url")
  role            UserRole  @default(USER) @map("role")
  twoFactorSecret String?   @map("two_factor_secret")
  isVerified      Boolean   @default(false) @map("is_verified")
  isGuest         Boolean   @default(false) @map("is_guest")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  sessions             Session[]
  preferences          UserPreference?
  practiceWallet       PracticeWallet?
  gameRounds           GameRound[]
  userAchievements     UserAchievement[]
  challengeProgress    ChallengeProgress[]
  leaderboardEntries   LeaderboardEntry[]
  supportTickets       SupportTicket[]
  notifications        Notification[]
  quizAttempts         QuizAttempt[]
  adminAuditLogs       AdminAuditLog[]
  accountRestrictions  AccountRestriction[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @map("id")
  userId       String   @map("user_id")
  refreshToken String   @map("refresh_token")
  deviceInfo   String?  @map("device_info")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("sessions")
}

model UserPreference {
  id                 String   @id @default(uuid()) @map("id")
  userId             String   @unique @map("user_id")
  language           Language @default(EN) @map("language")
  theme              Theme    @default(LIGHT) @map("theme")
  soundEnabled       Boolean  @default(true) @map("sound_enabled")
  reducedMotion      Boolean  @default(false) @map("reduced_motion")
  lowPerformanceMode Boolean  @default(false) @map("low_performance_mode")
  hideLeaderboard    Boolean  @default(false) @map("hide_leaderboard")
  sessionTimer       Int?     @map("session_timer")
  practicePointLimit Int?     @map("practice_point_limit")
  breakReminder      Int?     @map("break_reminder")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model PracticeWallet {
  id         String   @id @default(uuid()) @map("id")
  userId     String   @unique @map("user_id")
  balance    Decimal  @default(0) @map("balance")
  totalEarned Decimal @default(0) @map("total_earned")
  totalSpent  Decimal @default(0) @map("total_spent")
  lastResetAt DateTime? @map("last_reset_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PracticeTransaction[]

  @@map("practice_wallets")
}

model PracticeTransaction {
  id          String            @id @default(uuid()) @map("id")
  walletId    String            @map("wallet_id")
  amount      Decimal           @map("amount")
  type        TransactionType   @map("type")
  reason      TransactionReason @map("reason")
  referenceId String?           @map("reference_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  wallet PracticeWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([createdAt])
  @@map("practice_transactions")
}

model Game {
  id          String   @id @default(uuid()) @map("id")
  slug        String   @unique @map("slug")
  name        String   @map("name")
  description String   @map("description")
  category    String   @map("category")
  isActive    Boolean  @default(true) @map("is_active")
  config      Json     @default("{}") @map("config")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rounds          GameRound[]
  results         GameResult[]
  leaderboardEntries LeaderboardEntry[]

  @@map("games")
}

model GameRound {
  id         String     @id @default(uuid()) @map("id")
  gameId     String     @map("game_id")
  userId     String     @map("user_id")
  betAmount  Decimal    @map("bet_amount")
  multiplier Decimal?   @map("multiplier")
  payout     Decimal?   @map("payout")
  result     Json       @default("{}") @map("result")
  status     GameStatus @default(PENDING) @map("status")
  seed       String?    @map("seed")
  createdAt  DateTime   @default(now()) @map("created_at")

  game   Game        @relation(fields: [gameId], references: [id])
  user   User        @relation(fields: [userId], references: [id])
  result GameResult?

  @@index([gameId])
  @@index([userId])
  @@index([createdAt])
  @@map("game_rounds")
}

model GameResult {
  id          String   @id @default(uuid()) @map("id")
  roundId     String   @unique @map("round_id")
  gameId      String   @map("game_id")
  serverSeed  String   @map("server_seed")
  clientSeed  String   @map("client_seed")
  nonce       Int      @map("nonce")
  resultValue String   @map("result_value")
  resultData  Json     @default("{}") @map("result_data")
  createdAt   DateTime @default(now()) @map("created_at")

  round Game @relation(fields: [roundId], references: [id])
  game  Game @relation(fields: [gameId], references: [id])

  @@index([gameId])
  @@index([createdAt])
  @@map("game_results")
}

model Achievement {
  id            String   @id @default(uuid()) @map("id")
  slug          String   @unique @map("slug")
  name          String   @map("name")
  description   String   @map("description")
  iconUrl       String?  @map("icon_url")
  category      String   @map("category")
  criteria      Json     @default("{}") @map("criteria")
  rewardPoints  Int      @default(0) @map("reward_points")
  createdAt     DateTime @default(now()) @map("created_at")

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id             String   @id @default(uuid()) @map("id")
  userId         String   @map("user_id")
  achievementId  String   @map("achievement_id")
  unlockedAt     DateTime @default(now()) @map("unlocked_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@map("user_achievements")
}

model Challenge {
  id           String        @id @default(uuid()) @map("id")
  slug         String        @unique @map("slug")
  title        String        @map("title")
  description  String        @map("description")
  type         ChallengeType @map("type")
  requirements Json          @default("{}") @map("requirements")
  rewardPoints Int           @default(0) @map("reward_points")
  startsAt     DateTime      @map("starts_at")
  endsAt       DateTime      @map("ends_at")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")

  progress ChallengeProgress[]

  @@index([type])
  @@index([isActive])
  @@map("challenges")
}

model ChallengeProgress {
  id          String   @id @default(uuid()) @map("id")
  userId      String   @map("user_id")
  challengeId String   @map("challenge_id")
  progress    Json     @default("{}") @map("progress")
  isCompleted Boolean  @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId])
  @@index([challengeId])
  @@map("challenge_progress")
}

model LeaderboardEntry {
  id         String           @id @default(uuid()) @map("id")
  userId     String           @map("user_id")
  gameId     String           @map("game_id")
  score      Decimal          @map("score")
  period     LeaderboardPeriod @map("period")
  achievedAt DateTime         @default(now()) @map("achieved_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id])

  @@index([gameId, period, score])
  @@index([userId])
  @@map("leaderboard_entries")
}

model SupportTicket {
  id          String               @id @default(uuid()) @map("id")
  userId      String               @map("user_id")
  subject     String               @map("subject")
  message     String               @map("message")
  status      SupportTicketStatus  @default(OPEN) @map("status")
  priority    SupportTicketPriority @default(MEDIUM) @map("priority")
  adminNotes  String?              @map("admin_notes")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@map("support_tickets")
}

model Notification {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @map("user_id")
  type      String   @map("type")
  title     String   @map("title")
  message   String   @map("message")
  isRead    Boolean  @default(false) @map("is_read")
  link      String?  @map("link")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model EducationalLesson {
  id          String   @id @default(uuid()) @map("id")
  slug        String   @unique @map("slug")
  title       String   @map("title")
  description String   @map("description")
  content     Json     @default("{}") @map("content")
  category    String   @map("category")
  difficulty  String   @map("difficulty")
  orderIndex  Int      @default(0) @map("order_index")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quizzes Quiz[]

  @@index([category])
  @@index([orderIndex])
  @@map("educational_lessons")
}

model Quiz {
  id            String   @id @default(uuid()) @map("id")
  lessonId      String   @map("lesson_id")
  question      String   @map("question")
  options       Json     @default("[]") @map("options")
  correctAnswer String   @map("correct_answer")
  explanation   String?  @map("explanation")
  orderIndex    Int      @default(0) @map("order_index")

  lesson   EducationalLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts QuizAttempt[]

  @@index([lessonId])
  @@map("quizzes")
}

model QuizAttempt {
  id          String   @id @default(uuid()) @map("id")
  userId      String   @map("user_id")
  quizId      String   @map("quiz_id")
  score       Int      @default(0) @map("score")
  answers     Json     @default("{}") @map("answers")
  completedAt DateTime @default(now()) @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
  @@map("quiz_attempts")
}

model AdminAuditLog {
  id         String   @id @default(uuid()) @map("id")
  adminId    String   @map("admin_id")
  action     String   @map("action")
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  changes    Json     @default("{}") @map("changes")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model AccountRestriction {
  id        String          @id @default(uuid()) @map("id")
  userId    String          @map("user_id")
  type      RestrictionType @map("type")
  reason    String          @map("reason")
  expiresAt DateTime?       @map("expires_at")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
  @@map("account_restrictions")
}

model Announcement {
  id        String           @id @default(uuid()) @map("id")
  title     String           @map("title")
  content   String           @map("content")
  type      AnnouncementType @default(INFO) @map("type")
  isActive  Boolean          @default(true) @map("is_active")
  startsAt  DateTime?        @map("starts_at")
  endsAt    DateTime?        @map("ends_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([isActive, startsAt, endsAt])
  @@map("announcements")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @map("id")
  key         String   @unique @map("key")
  enabled     Boolean  @default(false) @map("enabled")
  description String?  @map("description")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}
